# Django Settings
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=vente_facile
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/1
TOKEN_CACHE_TTL=3600
PENDING_META_TTL_SECONDS=172800
POLL_BATCH_SIZE=50
CELERY_BROKER_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ventefacile.com

# Sentry (optional)
SENTRY_DSN=
ENVIRONMENT=development

# Logging
DJANGO_LOG_LEVEL=INFO

# MOKO / GoFreshPay
# URL absolue joignable depuis Internet pour POST /api/v1/subscriptions/moko/callback/
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
MOKO_API_V2_URL=https://moko.gofreshpay.com
MOKO_API_KEY=moko_api_key
# Secret partagé ajouté en ?token=... à l'URL de callback envoyée à MOKO,
# et vérifié à la réception. À générer (ex: `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
MOKO_CALLBACK_SECRET=

# Sécurité prod (optionnel, défauts raisonnables)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
